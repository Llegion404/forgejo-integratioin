{
  "name": "forgejo-vscode",
  "displayName": "Forgejo Integration (local)",
  "description": "Browse Pull Requests, Issues, and Actions from Forgejo, Gitea, and Codeberg directly in VS Code",
  "version": "0.3.18",
  "publisher": "localdev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "forgejo_icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Llegion404/forgejo-integratioin.git"
  },
  "keywords": [
    "forgejo",
    "codeberg",
    "gitea",
    "git",
    "scm",
    "self-hosted",
    "issues",
    "pull-request",
    "code-review",
    "actions",
    "ci-cd"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onCommand:forgejo.addInstance",
    "onCommand:forgejo.manageInstances",
    "onCommand:forgejo.createIssue",
    "onCommand:forgejo.createPullRequest",
    "onCommand:forgejo.createRelease",
    "onCommand:forgejo.showRepoOverview",
    "onCommand:forgejo.showRepoSettings",
    "onCommand:forgejo.compareRefs",
    "onCommand:forgejo.switchInstance"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoExplorer",
          "title": "Forgejo",
          "icon": "media/forgejo-icon.svg"
        }
      ]
    },
    "views": {
      "forgejoExplorer": [
        {
          "id": "forgejoPullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "forgejoIssues",
          "name": "Issues"
        },
        {
          "id": "forgejoActions",
          "name": "Actions"
        },
        {
          "id": "forgejoReleases",
          "name": "Releases"
        },
        {
          "id": "forgejoMilestones",
          "name": "Milestones"
        },
        {
          "id": "forgejoNotifications",
          "name": "Notifications"
        }
      ]
    },
    "commands": [
      {
        "command": "forgejo.addInstance",
        "title": "Forgejo: Add Instance",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.manageInstances",
        "title": "Forgejo: Manage Instances",
        "icon": "$(settings-gear)"
      },
      {
        "command": "forgejo.showDiagnostics",
        "title": "Forgejo: Show Diagnostics",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.showOutput",
        "title": "Forgejo: Show Output Channel",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.refreshPullRequests",
        "title": "Forgejo: Refresh Pull Requests",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.refreshIssues",
        "title": "Forgejo: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.configureInstanceUrl",
        "title": "Forgejo: Configure Instance URL (Legacy)"
      },
      {
        "command": "forgejo.setAuthToken",
        "title": "Forgejo: Set Authentication Token (Legacy)"
      },
      {
        "command": "forgejo.openPrInBrowser",
        "title": "Forgejo: Open PR in Browser"
      },
      {
        "command": "forgejo.openIssueInBrowser",
        "title": "Forgejo: Open Issue in Browser"
      },
      {
        "command": "forgejo.showPrFileDiff",
        "title": "Show Diff"
      },
      {
        "command": "forgejo.openPrInBrowserFromContext",
        "title": "Open PR in Browser"
      },
      {
        "command": "forgejo.openPrFileInBrowser",
        "title": "Open File in Browser"
      },
      {
        "command": "forgejo.openPrFileInEditor",
        "title": "Open File in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "forgejo.showPrDetails",
        "title": "View PR Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.mergePr",
        "title": "Merge PR...",
        "icon": "$(git-merge)"
      },
      {
        "command": "forgejo.closePr",
        "title": "Close PR",
        "icon": "$(circle-slash)"
      },
      {
        "command": "forgejo.showIssueDetails",
        "title": "View Issue Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.openIssueInBrowserFromContext",
        "title": "Open Issue in Browser"
      },
      {
        "command": "forgejo.createIssue",
        "title": "Forgejo: Create Issue",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.refreshActions",
        "title": "Forgejo: Refresh Actions",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.openActionInBrowser",
        "title": "Open Action in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "forgejo.rerunAction",
        "title": "Re-run Workflow",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "forgejo.cancelAction",
        "title": "Cancel Workflow",
        "icon": "$(debug-stop)"
      },
      {
        "command": "forgejo.viewActionLogs",
        "title": "View Logs",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.viewStepLogs",
        "title": "View Step Logs",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.showActionDetails",
        "title": "View Action Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.selectRemote",
        "title": "Forgejo: Select Git Remote"
      },
      {
        "command": "forgejo.createPullRequest",
        "title": "Forgejo: Create Pull Request",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "forgejo.submitInlineComment",
        "title": "Submit Comment"
      },
      {
        "command": "forgejo.refreshReleases",
        "title": "Forgejo: Refresh Releases",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.createRelease",
        "title": "Forgejo: Create Release",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.exportMcpConfig",
        "title": "Forgejo: Configure MCP for Agents...",
        "icon": "$(symbol-event)"
      },
      {
        "command": "forgejo.openReleaseInBrowser",
        "title": "Open Release in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "forgejo.reviewPrChanges",
        "title": "Review All PR Changes",
        "icon": "$(book)"
      },
      {
        "command": "forgejo.showReleaseDetails",
        "title": "View Release Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.sortPullRequests",
        "title": "Sort Pull Requests...",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "forgejo.sortIssues",
        "title": "Sort Issues...",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "forgejo.filterPullRequests",
        "title": "Filter Pull Requests...",
        "icon": "$(filter)"
      },
      {
        "command": "forgejo.filterIssues",
        "title": "Filter Issues...",
        "icon": "$(filter)"
      },
      {
        "command": "forgejo.switchInstance",
        "title": "Forgejo: Switch Active Instance",
        "icon": "$(server)"
      },
      {
        "command": "forgejo.showRepoOverview",
        "title": "Forgejo: Show Repository Overview",
        "icon": "$(repo)"
      },
      {
        "command": "forgejo.compareRefs",
        "title": "Forgejo: Compare References...",
        "icon": "$(compare-changes)"
      },
      {
        "command": "forgejo.refreshNotifications",
        "title": "Forgejo: Refresh Notifications",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.markNotificationRead",
        "title": "Mark Notification as Read",
        "icon": "$(check)"
      },
      {
        "command": "forgejo.markAllNotificationsRead",
        "title": "Mark All Notifications as Read",
        "icon": "$(check-all)"
      },
      {
        "command": "forgejo.showRepoSettings",
        "title": "Forgejo: Show Repository Settings",
        "icon": "$(gear)"
      },
      {
        "command": "forgejo.refreshMilestones",
        "title": "Forgejo: Refresh Milestones",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forgejo.createPullRequest",
          "when": "view == forgejoPullRequests",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoPullRequests",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.sortPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.filterPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation@4"
        },
        {
          "command": "forgejo.switchInstance",
          "when": "view == forgejoPullRequests",
          "group": "navigation@4"
        },
        {
          "command": "forgejo.createIssue",
          "when": "view == forgejoIssues",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshIssues",
          "when": "view == forgejoIssues",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoIssues",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.sortIssues",
          "when": "view == forgejoIssues",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.filterIssues",
          "when": "view == forgejoIssues",
          "group": "navigation@4"
        },
        {
          "command": "forgejo.switchInstance",
          "when": "view == forgejoIssues",
          "group": "navigation@4"
        },
        {
          "command": "forgejo.refreshActions",
          "when": "view == forgejoActions",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoActions",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.createRelease",
          "when": "view == forgejoReleases",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshReleases",
          "when": "view == forgejoReleases",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoReleases",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.refreshMilestones",
          "when": "view == forgejoMilestones",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.switchInstance",
          "when": "view == forgejoMilestones",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.refreshNotifications",
          "when": "view == forgejoNotifications",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.markAllNotificationsRead",
          "when": "view == forgejoNotifications",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "forgejo.showPrDetails",
          "when": "viewItem == prOverview",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.openPrInBrowserFromContext",
          "when": "viewItem == pullRequest",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.mergePr",
          "when": "viewItem == pullRequest",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.closePr",
          "when": "viewItem == pullRequest",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.openPrFileInBrowser",
          "when": "viewItem == prFile",
          "group": "navigation"
        },
        {
          "command": "forgejo.openPrFileInEditor",
          "when": "viewItem == prFile",
          "group": "inline"
        },
        {
          "command": "forgejo.showIssueDetails",
          "when": "viewItem == issue",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.openIssueInBrowserFromContext",
          "when": "viewItem == issue",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.showActionDetails",
          "when": "viewItem == workflowRun || viewItem == workflowJob",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.openActionInBrowser",
          "when": "viewItem == workflowRun || viewItem == workflowJob || viewItem == workflowStep",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.rerunAction",
          "when": "viewItem == workflowRun || viewItem == workflowJob",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.cancelAction",
          "when": "viewItem == workflowRun || viewItem == workflowJob",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.viewActionLogs",
          "when": "viewItem == workflowRun || viewItem == workflowJob || viewItem == workflowStep",
          "group": "navigation@4"
        },
        {
          "command": "forgejo.openReleaseInBrowser",
          "when": "viewItem == release || viewItem == releaseDraft || viewItem == releasePrerelease",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.showReleaseDetails",
          "when": "viewItem == release || viewItem == releaseDraft || viewItem == releasePrerelease",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.markNotificationRead",
          "when": "viewItem == notification",
          "group": "navigation@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "forgejo.submitInlineComment",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "forgejoPullRequests",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoIssues",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoActions",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoReleases",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoMilestones",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoNotifications",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      }
    ],
    "configuration": {
      "title": "Forgejo",
      "properties": {
        "forgejo.instances": {
          "type": "array",
          "default": [],
          "description": "Configured Forgejo instances",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "instanceUrl": {
                "type": "string"
              },
              "token": {
                "type": "string",
                "deprecationMessage": "Tokens are now stored securely in the OS keychain via VS Code SecretStorage. Any token here will be migrated automatically."
              },
              "isDefault": {
                "type": "boolean"
              },
              "lastConnectionTest": {
                "type": "object"
              }
            }
          }
        },
        "forgejo.instanceUrl": {
          "type": "string",
          "default": "",
          "description": "[DEPRECATED] Use forgejo.instances instead. Forgejo instance URL (e.g., https://codeberg.org)",
          "deprecationMessage": "Use 'forgejo.instances' for multi-instance support. This setting is kept for backward compatibility."
        },
        "forgejo.token": {
          "type": "string",
          "default": "",
          "description": "[DEPRECATED] Tokens are now stored securely via VS Code SecretStorage (OS keychain). Any token here will be migrated automatically on next activation.",
          "deprecationMessage": "Tokens are now stored securely via VS Code SecretStorage. This setting is kept only for backward compatibility migration."
        },
        "forgejo.autoDetectFromRemote": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect Forgejo instance from git remote"
        },
        "forgejo.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging in the Forgejo output channel"
        },
        "forgejo.showFileStatusNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when opening files that were added or deleted in a pull request"
        },
        "forgejo.preferredRemote": {
          "type": "string",
          "default": "",
          "description": "Preferred git remote name to use for Forgejo detection (default: auto-detect, falls back to origin)"
        },
        "forgejo.prDiffMode": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "default": "local",
          "enumDescriptions": [
            "Diff against your actual local working file (editable). Requires the PR branch to be checked out.",
            "Diff base vs head content fetched from the API (read-only, no local checkout needed)."
          ],
          "description": "How PR file diffs are opened: 'local' diffs against your working copy (editable), 'remote' shows a read-only API-fetched diff."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.test.json && mkdir -p out/webview/shared && cp src/webview/shared/*.js src/webview/shared/*.css out/webview/shared/ && cp src/webview/prDetail/index.js src/webview/prDetail/styles.css out/webview/prDetail/ && mkdir -p out/webview/issueDetail && cp src/webview/issueDetail/index.js src/webview/issueDetail/styles.css out/webview/issueDetail/ && mkdir -p out/webview/actionDetail && cp src/webview/actionDetail/index.js src/webview/actionDetail/styles.css out/webview/actionDetail/ && mkdir -p out/webview/releaseDetail && cp src/webview/releaseDetail/index.js src/webview/releaseDetail/styles.css out/webview/releaseDetail/ && mkdir -p out/webview/review && cp src/webview/review/index.js src/webview/review/styles.css out/webview/review/ && mkdir -p out/webview/repoOverview && cp src/webview/repoOverview/index.js src/webview/repoOverview/styles.css out/webview/repoOverview/ && mkdir -p out/webview/compare && cp src/webview/compare/index.js src/webview/compare/styles.css out/webview/compare/ && mkdir -p out/webview/settings && cp src/webview/settings/index.js src/webview/settings/styles.css out/webview/settings/",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish-vscode": "echo 'Use: vsce publish -p <PAT>'",
    "lint": "eslint src --ext ts",
    "lint:webview": "eslint --no-eslintrc --config .eslintrc.webview.json src/webview --ext js",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "pretest:integration": "npm run compile",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:vscode": "playwright test --config playwright.vscode.config.ts",
    "test:e2e:vscode:headed": "playwright test --config playwright.vscode.config.ts --headed",
    "test:e2e:vscode:debug": "playwright test --config playwright.vscode.config.ts --debug",
    "test:ci": "npm run lint && npm run test:unit:coverage && npm run test:integration",
    "test:live": "jest --testPathPattern='\\.live\\.test'",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:live:local": "bash scripts/run-e2e-local.sh"
  },
  "devDependencies": {
    "@mshanemc/vscode-test-playwright": "^0.0.1-beta14",
    "@playwright/test": "~1.52.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "forgejo-ts": "^0.3.1"
  }
}
