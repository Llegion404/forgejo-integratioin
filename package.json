{
  "name": "forgejo-vscode",
  "displayName": "Forgejo Integration",
  "description": "Browse Forgejo Pull Requests and Issues directly in VS Code",
  "version": "0.1.0",
  "publisher": "forgejo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoExplorer",
          "title": "Forgejo",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "forgejoExplorer": [
        {
          "id": "forgejoPullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "forgejoIssues",
          "name": "Issues"
        }
      ]
    },
    "commands": [
      {
        "command": "forgejo.refreshPullRequests",
        "title": "Forgejo: Refresh Pull Requests",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.refreshIssues",
        "title": "Forgejo: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.configureInstanceUrl",
        "title": "Forgejo: Configure Instance URL"
      },
      {
        "command": "forgejo.setAuthToken",
        "title": "Forgejo: Set Authentication Token"
      },
      {
        "command": "forgejo.openPrInBrowser",
        "title": "Forgejo: Open PR in Browser"
      },
      {
        "command": "forgejo.openIssueInBrowser",
        "title": "Forgejo: Open Issue in Browser"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forgejo.refreshPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation"
        },
        {
          "command": "forgejo.refreshIssues",
          "when": "view == forgejoIssues",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Forgejo",
      "properties": {
        "forgejo.instanceUrl": {
          "type": "string",
          "default": "",
          "description": "Forgejo instance URL (e.g., https://codeberg.org)"
        },
        "forgejo.token": {
          "type": "string",
          "default": "",
          "description": "Personal access token for authentication"
        },
        "forgejo.autoDetectFromRemote": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect Forgejo instance from git remote"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "pretest:integration": "npm run compile",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "test:ci": "npm run lint && npm run test:unit:coverage && npm run test:integration"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
