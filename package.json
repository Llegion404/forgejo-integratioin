{
  "name": "forgejo-vscode",
  "displayName": "Forgejo Integration",
  "description": "Browse Forgejo Pull Requests and Issues directly in VS Code",
  "version": "0.1.0",
  "publisher": "forgejo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoExplorer",
          "title": "Forgejo",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "forgejoExplorer": [
        {
          "id": "forgejoPullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "forgejoIssues",
          "name": "Issues"
        }
      ]
    },
    "webviews": {
      "viewContainers": [
        {
          "id": "forgejo.prDetail",
          "name": "PR Details"
        },
        {
          "id": "forgejo.issueDetail",
          "name": "Issue Details"
        }
      ]
    },
    "commands": [
      {
        "command": "forgejo.addInstance",
        "title": "Forgejo: Add Instance",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.manageInstances",
        "title": "Forgejo: Manage Instances",
        "icon": "$(settings-gear)"
      },
      {
        "command": "forgejo.showDiagnostics",
        "title": "Forgejo: Show Diagnostics",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.showOutput",
        "title": "Forgejo: Show Output Channel",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.refreshPullRequests",
        "title": "Forgejo: Refresh Pull Requests",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.refreshIssues",
        "title": "Forgejo: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.configureInstanceUrl",
        "title": "Forgejo: Configure Instance URL (Legacy)"
      },
      {
        "command": "forgejo.setAuthToken",
        "title": "Forgejo: Set Authentication Token (Legacy)"
      },
      {
        "command": "forgejo.openPrInBrowser",
        "title": "Forgejo: Open PR in Browser"
      },
      {
        "command": "forgejo.openIssueInBrowser",
        "title": "Forgejo: Open Issue in Browser"
      },
      {
        "command": "forgejo.showPrFileDiff",
        "title": "Show Diff"
      },
      {
        "command": "forgejo.openPrInBrowserFromContext",
        "title": "Open PR in Browser"
      },
      {
        "command": "forgejo.openPrFileInBrowser",
        "title": "Open File in Browser"
      },
      {
        "command": "forgejo.showPrDetails",
        "title": "View PR Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.mergePr",
        "title": "Merge PR...",
        "icon": "$(git-merge)"
      },
      {
        "command": "forgejo.closePr",
        "title": "Close PR",
        "icon": "$(circle-slash)"
      },
      {
        "command": "forgejo.showIssueDetails",
        "title": "View Issue Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.openIssueInBrowserFromContext",
        "title": "Open Issue in Browser"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forgejo.refreshPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoPullRequests",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.refreshIssues",
          "when": "view == forgejoIssues",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoIssues",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "forgejo.showPrDetails",
          "when": "viewItem == prOverview",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.openPrInBrowserFromContext",
          "when": "viewItem == pullRequest",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.mergePr",
          "when": "viewItem == pullRequest",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.closePr",
          "when": "viewItem == pullRequest",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.openPrFileInBrowser",
          "when": "viewItem == prFile",
          "group": "navigation"
        },
        {
          "command": "forgejo.showIssueDetails",
          "when": "viewItem == issue",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.openIssueInBrowserFromContext",
          "when": "viewItem == issue",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Forgejo",
      "properties": {
        "forgejo.instances": {
          "type": "array",
          "default": [],
          "description": "Configured Forgejo instances",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "instanceUrl": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "isDefault": {
                "type": "boolean"
              },
              "lastConnectionTest": {
                "type": "object"
              }
            }
          }
        },
        "forgejo.instanceUrl": {
          "type": "string",
          "default": "",
          "description": "[DEPRECATED] Use forgejo.instances instead. Forgejo instance URL (e.g., https://codeberg.org)",
          "deprecationMessage": "Use 'forgejo.instances' for multi-instance support. This setting is kept for backward compatibility."
        },
        "forgejo.token": {
          "type": "string",
          "default": "",
          "description": "[DEPRECATED] Use forgejo.instances instead. Personal access token for authentication",
          "deprecationMessage": "Use 'forgejo.instances' for multi-instance support. This setting is kept for backward compatibility."
        },
        "forgejo.autoDetectFromRemote": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect Forgejo instance from git remote"
        },
        "forgejo.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging in the Forgejo output channel"
        },
        "forgejo.showFileStatusNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when opening files that were added or deleted in a pull request"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && cp src/webview/prDetail/index.js src/webview/prDetail/styles.css out/webview/prDetail/ && mkdir -p out/webview/issueDetail && cp src/webview/issueDetail/index.js src/webview/issueDetail/styles.css out/webview/issueDetail/",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "pretest:integration": "npm run compile",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "test:ci": "npm run lint && npm run test:unit:coverage && npm run test:integration"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
